# Copy to .env.local and fill in. .env.local is gitignored — never commit a key.
#
# Enables the optional AI why-line for custom crops (/api/enrich). Without it
# the app behaves exactly as it did before Phase 4: custom crops work, they
# just carry no generated "Why:" line.
#
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
